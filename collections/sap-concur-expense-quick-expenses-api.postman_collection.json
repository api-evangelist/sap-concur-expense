  "info": {
    "_postman_id": "d1e35fef-bd70-46a9-96eb-f363e9248b27",
    "name": "SAP Concur Expense Allocations Quick Expenses API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "SAP Concur Expense provides REST APIs for managing the full expense lifecycle including creating and submitting expense reports, managing individual expense entries, capturing receipt images, handling quick expenses, managing allocations across cost centers, and retrieving reimbursement payment batches. Authentication uses OAuth 2.0 with support for authorization code and refresh token flows.\n\nContact Support:\n Name: SAP Concur Developer Support",
      "type": "text/plain"
    }
  }
